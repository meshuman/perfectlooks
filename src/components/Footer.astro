---
import Logo from './Logo.astro';
import { menuMark } from '@/data/brand-marks.mjs';
import { defaultShop as shop } from '@/data/shop';
import { WOMEN_LIVE } from '@/data/flags';
import { womenCategories } from '@/data/women';
import { useI18n, type UiKey } from '@/i18n';
const { t, l } = useI18n(Astro.url);
const whatsappHref = `https://wa.me/${shop.phone.replace(/\D/g, '')}?text=${encodeURIComponent(t('contact.whatsappMessage', { shop: shop.name }))}`;

// Links follow the section you are in: both sides on the landing page, one side inside /men or /women.
const path = Astro.url.pathname.replace(/^\/(ne|hi)(?=\/|$)/, '');
const inWomen = path === '/women' || path.startsWith('/women/');
const inMen = path === '/men' || path.startsWith('/men/');

const menLinks = [
  { href: l('/men/hair'), label: t('category.hair.label') },
  { href: l('/men/beards'), label: t('category.beards.label') },
  { href: l('/men/moustaches'), label: t('category.moustaches.label') },
  { href: l('/men/colours'), label: t('category.colours.label') },
  { href: l('/men/looks'), label: t('category.looks.label') },
  { href: l('/men/add-ons'), label: t('addons.link') },
  { href: l('/men/learn'), label: t('nav.learn') },
];
const womenLinks = [
  ...womenCategories.map((c) => ({ href: l(`/women/${c.key}`), label: t(`wcat.${c.key}.label` as UiKey) })),
  { href: l('/women/learn'), label: t('nav.learn') },
];
const columns = [
  ...(inWomen ? [] : [{ title: t('who.men'), href: l('/men'), links: menLinks, soon: false }]),
  ...(inMen || !WOMEN_LIVE ? [] : [{ title: t('who.women'), href: l('/women'), links: womenLinks, soon: false }]),
  // Until the women's section is live, the live site lists it as Coming soon.
  ...(!inMen && !inWomen && !WOMEN_LIVE ? [{ title: t('who.women'), href: undefined, links: [], soon: true }] : []),
];
// Inside one side, a single link crosses over to the other.
const crossOver = inMen && WOMEN_LIVE ? { href: l('/women'), label: t('who.women') } : inWomen ? { href: l('/men'), label: t('who.men') } : undefined;
---

<footer class="bg-ink pt-14 pb-28 text-white">
  <div class="wrap">
    <Logo tone="dark" size="lg" />
    <p class="mt-5 max-w-sm text-[0.9375rem] text-muted-dark">{t('site.tagline')}</p>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div class="grid gap-8 sm:grid-cols-2">
        {
          (inMen ? menLinks : inWomen ? womenLinks : []).length > 0 ? (
            <nav aria-label={t('footer.catalogue')} class="sm:col-span-2">
              <h2 class="text-sm font-medium tracking-wide text-muted-dark">{inMen ? t('who.men') : t('who.women')}</h2>
              <ul class="mt-2 grid grid-cols-2 gap-x-6 text-[0.9375rem]">
                {(inMen ? menLinks : womenLinks).map((link) => (
                  <li><a href={link.href} class="flex min-h-11 items-center underline-offset-4 hover:underline">{link.label}</a></li>
                ))}
                {inMen && !WOMEN_LIVE && (
                  <li class="flex min-h-11 items-center gap-2 text-muted-dark">
                    {t('who.women')}
                    <span class="rounded-full bg-white/10 px-2 py-0.5 text-[0.625rem] font-semibold tracking-[0.1em] text-white uppercase">{t('site.comingSoon')}</span>
                  </li>
                )}
                {crossOver && <li><a href={crossOver.href} class="flex min-h-11 items-center font-medium text-gold underline-offset-4 hover:underline">{crossOver.label} →</a></li>}
              </ul>
            </nav>
          ) : (
            columns.map((col) => (
              <nav aria-label={col.title}>
                <h2 class="text-sm font-medium tracking-wide text-muted-dark">
                  {col.href ? <a href={col.href} class="underline-offset-4 hover:underline">{col.title}</a> : col.title}
                  {col.soon && <span class="ml-2 rounded-full bg-white/10 px-2 py-0.5 text-[0.625rem] font-semibold tracking-[0.1em] text-white uppercase">{t('site.comingSoon')}</span>}
                </h2>
                <ul class="mt-2 grid grid-cols-2 gap-x-4 text-[0.9375rem] sm:block">
                  {col.links.map((link) => (
                    <li><a href={link.href} class="flex min-h-11 items-center underline-offset-4 hover:underline">{link.label}</a></li>
                  ))}
                </ul>
              </nav>
            ))
          )
        }
      </div>

      <div>
        <h2 class="text-sm font-medium tracking-wide text-muted-dark">{t('footer.visit')}</h2>
        <p data-shop-name class="mt-4 text-[1.0625rem] font-semibold">{shop.name}</p>
        <ul class="mt-1 text-[0.9375rem] text-muted-dark">
          <li><a href={`tel:${shop.phone}`} class="flex min-h-11 items-center underline-offset-4 hover:text-white hover:underline">{shop.phoneDisplay}</a></li>
        </ul>
        <a href={whatsappHref} target="_blank" rel="noopener" class="mt-2 inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium text-gold underline-offset-4 hover:underline">
          {t('contact.whatsapp')}
        </a>
        <button type="button" data-install hidden class="flex min-h-11 items-center gap-2 text-left text-[0.9375rem] font-medium text-white underline underline-offset-4">{t('install.button')}</button>
        <p data-install-hint hidden class="max-w-xs pb-2 text-[0.8125rem] leading-snug text-muted-dark">{t('install.iosHint')}</p>
        <a href={l('/play')} class="flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium text-white underline-offset-4 hover:underline">
          {t('footer.play')}
        </a>
        <a href={l('/feedback')} class="flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium text-white underline underline-offset-4">
          {t('feedback.link')}
        </a>
      </div>
    </div>

    {/* Shown only on a shop's own address: who made this menu, and how another salon can have one. */}
    <div data-powered hidden class="mt-12 flex flex-wrap items-center justify-between gap-5 border-t border-line-dark pt-6">
      <a href={Astro.site?.href ?? 'https://looksmenu.com'} class="inline-flex items-center gap-3">
        <svg viewBox="0 0 100 100" class="size-11 shrink-0" aria-hidden="true" set:html={menuMark()} />
        <span>
          <span class="block text-[0.6875rem] font-semibold tracking-[0.18em] text-muted-dark uppercase">{t('powered.by')}</span>
          <span class="block text-[1.375rem] leading-tight font-bold tracking-[-0.02em]"><span class="text-teal">looks</span><span class="font-medium text-cream">menu</span><span class="font-medium text-muted-dark">.com</span></span>
        </span>
      </a>
      <div class="max-w-xs">
        <p class="text-[0.875rem] leading-snug text-muted-dark">{t('powered.cta')}</p>
        <a href={Astro.site?.href ?? 'https://looksmenu.com'} class="mt-1 inline-flex min-h-11 items-center text-[0.8125rem] font-bold tracking-[0.12em] text-gold uppercase underline underline-offset-[6px]">
          {t('powered.button')}
        </a>
      </div>
    </div>

    <p class="mt-8 border-t border-line-dark pt-5 text-xs text-muted-dark">{t('site.disclaimer')}</p>
  </div>
</footer>
