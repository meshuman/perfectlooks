---
// One compact button (globe + current language) that opens a short list. Keeps the header light on phones.
import Icon from './Icon.astro';
import { i18n, LOCALE_NAMES, pathIn, publishedLocales, useI18n, type Locale } from '@/i18n';
const { t, locale } = useI18n(Astro.url);

interface Props {
  tone?: 'dark' | 'light';
  /** false on pages built only in English (404, offline): languages link to their home page. */
  localized?: boolean;
}

const { tone = 'light', localized = true } = Astro.props;

// Each name in its own script. A language links to this same page once its pages are built.
const published = publishedLocales();
const langs = (['en', 'ne', 'hi'] as Locale[]).map((code) => ({
  code,
  label: LOCALE_NAMES[code],
  ready: code === 'en' || published.includes(code as Exclude<Locale, 'en'>),
}));
const current = langs.find((lang) => lang.code === locale)!;
---

{/* On English pages the two Devanagari names use the phone's own font, so the 97 KB Mukta file is only downloaded where it is needed. */}
<details data-lang-menu class:list={['group/lang relative', locale === 'en' && '[font-family:system-ui,sans-serif]']}>
  <summary
    aria-label={`${t('site.language')}: ${current.label}`}
    class="flex min-h-11 cursor-pointer list-none items-center gap-1.5 px-1.5 text-[0.75rem] font-semibold [&::-webkit-details-marker]:hidden"
  >
    <Icon name="globe" size={16} strokeWidth={1.5} />
    <span lang={current.code}>{current.label}</span>
    <Icon name="chevronDown" size={12} strokeWidth={2} class="transition-transform duration-300 ease-out-soft group-open/lang:rotate-180" />
  </summary>
  <ul
    class="absolute top-full right-0 z-40 mt-1 min-w-32 bg-card p-1 text-text shadow-[0_12px_32px_rgb(17_17_17/0.14),inset_0_0_0_1px_var(--color-line)]"
    aria-label={t('site.language')}
  >
    {
      langs.map((lang) => {
        const active = lang.code === locale;
        return (
          <li>
            <a
              href={lang.ready ? (localized ? pathIn(lang.code, Astro.url) : i18n(lang.code).l('/')) : undefined}
              hreflang={lang.ready ? lang.code : undefined}
              lang={lang.code}
              aria-current={active ? 'true' : undefined}
              aria-disabled={lang.ready ? undefined : 'true'}
              title={lang.ready ? undefined : t('site.comingSoon')}
              class:list={[
                'flex min-h-11 items-center justify-between gap-4 px-3 text-[0.875rem] transition duration-300 ease-out-soft hover:bg-paper-2',
                active && 'font-semibold',
                !lang.ready && 'cursor-not-allowed text-muted',
              ]}
            >
              {lang.label}
              {active && <Icon name="check" size={14} strokeWidth={2.5} />}
            </a>
          </li>
        );
      })
    }
  </ul>
</details>

<script>
  // Close the list when the visitor taps elsewhere or presses Escape.
  const menus = () => Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu][open]'));
  document.addEventListener('click', (event) => {
    for (const menu of menus()) if (!menu.contains(event.target as Node)) menu.open = false;
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') for (const menu of menus()) menu.open = false;
  });
</script>
