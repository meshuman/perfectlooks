---
import Icon from './Icon.astro';
import type { IconName } from '@/data/icons';
import { useI18n } from '@/i18n';
const { t } = useI18n(Astro.url);

interface Props {
  daily: string;
  weekly: string;
  nextVisit: string;
  atShop?: string;
}

const { daily, weekly, nextVisit, atShop } = Astro.props;

const capitalise = (s: string) => s.charAt(0).toUpperCase() + s.slice(1);

// "5 min: blow dry the front up, then wax." -> "5 min" / "Blow dry the front up, then wax."
// "in 2–3 weeks, to keep the fade clean"    -> "In 2–3 weeks" / "To keep the fade clean"
function split(text: string): { head: string; detail?: string } {
  const match = text.match(/^([^:]{1,14}):\s*(.+)$/) ?? text.match(/^(in [^,]+),\s*(.+)$/i);
  if (!match) return { head: capitalise(text) };
  return { head: capitalise(match[1]!), detail: capitalise(match[2]!) };
}

const rows: { label: string; icon: IconName; text: string }[] = [
  { label: t('detail.daily'), icon: 'clock', text: daily },
  { label: t('detail.weekly'), icon: 'calendar', text: weekly },
  { label: t('detail.nextVisit'), icon: 'scissors', text: nextVisit },
];
if (atShop) rows.push({ label: t('detail.atShop'), icon: 'clock', text: atShop });
---

<div class="shell">
<ul class="core divide-y divide-line/70 overflow-hidden">
  {
    rows.map((row) => {
      const { head, detail } = split(row.text);
      return (
        <li class="flex items-start gap-3 p-4">
          <span class="grid size-10 shrink-0 place-items-center rounded-full bg-paper-2 text-ink">
            <Icon name={row.icon} size={18} />
          </span>
          <div class="min-w-0">
            <p class="text-xs font-semibold text-muted">{row.label}</p>
            {/* Short answers ("2 min", "Nothing.") read as a headline; full sentences don't. */}
            <p class:list={['text-[0.9375rem]', (detail || head.length <= 24) && 'font-bold']}>{head}</p>
            {detail && <p class="text-sm text-muted">{detail}</p>}
          </div>
        </li>
      );
    })
  }
</ul>
</div>
