---
import Icon from './Icon.astro';
import { useI18n } from '@/i18n';
const { t } = useI18n(Astro.url);

interface Group {
  /** Shown above the steps when there is more than one group, e.g. "Hair · Low Fade". */
  title?: string;
  steps: string[];
  note?: string;
}

interface Props {
  groups: Group[];
  open?: boolean;
}

const { groups, open = false } = Astro.props;
---

{/* The tray wraps <details>: <summary> has to be the first child of <details>. */}
<div class="bg-ink p-1.5 text-white shadow-lift">
<details class="group core-dark overflow-hidden" open={open}>
  <summary class="flex cursor-pointer list-none items-center justify-between gap-3 p-4 [&::-webkit-details-marker]:hidden">
    <span class="flex items-center gap-3">
      <span class="gold-fill grid size-10 place-items-center rounded-full">
        <Icon name="scissors" size={18} strokeWidth={2} />
      </span>
      <span class="text-[1.0625rem] font-semibold">{t('detail.whatBarberDoes')}</span>
    </span>
    <span class="grid size-8 place-items-center rounded-full bg-white/[0.07] text-muted-dark transition duration-500 ease-out-soft group-open:rotate-180 group-open:text-gold">
      <Icon name="chevronDown" size={16} strokeWidth={2} />
    </span>
  </summary>
  <div class="space-y-5 px-4 pb-4">
    {
      groups.map((group) => (
        <div>
          {group.title && <p class="eyebrow-dark mb-2.5">{group.title}</p>}
          <ol class="space-y-2.5">
            {group.steps.map((step, i) => (
              <li class="flex items-start gap-3">
                <span class="grid size-6 shrink-0 place-items-center rounded-full border border-white/40 text-xs font-semibold text-white">{i + 1}</span>
                <span class="pt-0.5 text-[0.9375rem]">{step}</span>
              </li>
            ))}
          </ol>
          {group.note && <p class="mt-3 bg-white/6 p-3 text-sm text-muted-dark">{group.note}</p>}
        </div>
      ))
    }
  </div>
</details>
</div>
