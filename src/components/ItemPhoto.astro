---
// A catalogue photo, resized and converted to WebP for phones. Falls back to the colour swatch
// or the branded placeholder while the item has no photo yet.
import { Image } from 'astro:assets';
import PhotoPlaceholder from './PhotoPlaceholder.astro';
import { photoFor } from '@/data/photos';
import { useI18n } from '@/i18n';
const { t } = useI18n(Astro.url);

interface Props {
  item: { id: string; name: string; mainPhoto: 'front' | 'side'; swatch?: string };
  /** card: grid thumbnails. hero: the large photo on the item page. */
  size?: 'card' | 'hero';
  class?: string;
  /** Extra classes for the swatch circle, e.g. the hover zoom on cards. */
  swatchClass?: string;
  /** Colour block for the placeholder, e.g. 'bg-block-orange'. */
  block?: string;
  /** The photo only repeats a nearby label, so it has no alt text of its own. */
  decorative?: boolean;
}

const { item, size = 'card', class: className, swatchClass, block, decorative = false } = Astro.props;
const photo = photoFor(item.id);

const SIZES = {
  card: { widths: [240, 360, 480, 720], sizes: '(min-width: 64rem) 22vw, (min-width: 48rem) 30vw, 46vw' },
  hero: { widths: [400, 640, 800, 1080], sizes: '(min-width: 48rem) 45vw, 92vw' },
};
---

{
  photo ? (
    <Image
      src={photo}
      alt={decorative ? '' : `${item.name}, ${t('card.view', { angle: t(item.mainPhoto === 'side' ? 'angle.side' : 'angle.front') }).toLowerCase()}`}
      format="webp"
      quality={78}
      widths={SIZES[size].widths}
      sizes={SIZES[size].sizes}
      loading={size === 'hero' ? 'eager' : 'lazy'}
      fetchpriority={size === 'hero' ? 'high' : 'auto'}
      decoding="async"
      class:list={['object-cover', className]}
    />
  ) : item.swatch ? (
    <div class:list={['photo-bg grid place-items-center', className]}>
      <span class:list={['size-[58%] rounded-full', swatchClass]} style={`background:${item.swatch}`} />
    </div>
  ) : (
    <PhotoPlaceholder seed={item.id || item.name} block={block} class={className} label={size === 'hero' ? t('card.photoSoon') : ''} />
  )
}
