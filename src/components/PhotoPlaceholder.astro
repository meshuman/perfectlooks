---
// The one placeholder for any style, look or category without a photo yet: its colour block with a
// tone-on-tone KGF scissors mark, so a list of mixed photos and placeholders reads as one set.
import { scissorsMark } from '@/data/brand-marks.mjs';
import { backdropFor } from '@/lib/backdrop';

interface Props {
  label?: string;
  /** Picks a stable colour-block background, e.g. the item ID. */
  seed?: string;
  /** Forces one colour block instead, e.g. 'bg-block-orange'. */
  block?: string;
  class?: string;
  /** Kept so older callers still compile; the placeholder no longer varies by category. */
  icon?: string;
}

const { label, seed = '', block: forced, class: className } = Astro.props;

// The same backdrop the item's photo is generated on, so nothing shifts when the photo arrives.
const block = forced ?? backdropFor(seed).className;
---

<div class:list={['relative flex flex-col items-center justify-center gap-3 text-ink', block, className]}>
  <svg viewBox="0 0 100 100" class="w-[34%] max-w-32 text-ink/25" aria-hidden="true" set:html={scissorsMark('currentColor')} />
  {label && <span class="text-[0.6875rem] font-semibold tracking-[0.14em] text-ink uppercase">{label}</span>}
</div>
