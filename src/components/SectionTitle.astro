---
// The one section heading for detail pages: a short KGF-crimson bar above the title.
interface Props {
  as?: 'h2' | 'h3';
  class?: string;
}

const { as: Tag = 'h2', class: className } = Astro.props;
---

<div class:list={['mb-4', className]}>
  <span class="mb-2.5 block h-0.5 w-7 bg-brand" aria-hidden="true"></span>
  <Tag class="text-[1.375rem] leading-tight"><slot /></Tag>
</div>
