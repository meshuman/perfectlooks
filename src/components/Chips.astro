---
interface Props {
  items: { label: string; href?: string; active?: boolean }[];
  label: string;
}

const { items, label } = Astro.props;
---

<nav aria-label={label} class="-mx-4 overflow-x-auto px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden">
  <ul class="flex w-max gap-2">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.active ? 'true' : undefined}
            class:list={[
              'block px-4 py-2.5 text-[0.8125rem] font-semibold whitespace-nowrap transition duration-300 ease-out-soft',
              item.active
                ? 'bg-ink text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.08)]'
                : 'bg-card text-text shadow-[inset_0_0_0_1px_var(--color-line)] hover:shadow-[inset_0_0_0_1px_rgb(28_24_21/0.25)]',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
