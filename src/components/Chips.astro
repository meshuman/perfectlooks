---
interface Props {
  items: { label: string; href?: string; active?: boolean }[];
  label: string;
}

const { items, label } = Astro.props;
---

{/* Sticks under the header, so you can switch category from anywhere down the list. */}
<nav
  aria-label={label}
  class="sticky top-16 z-20 -mx-4 overflow-x-auto bg-paper px-4 py-2 shadow-[0_1px_0_var(--color-line)] [scrollbar-width:none] md:mx-0 md:px-0 [&::-webkit-scrollbar]:hidden"
>
  <ul class="flex w-max gap-2">
    {
      items.map((item) => (
        <li>
          <a
            href={item.href}
            aria-current={item.active ? 'true' : undefined}
            class:list={[
              'flex h-11 items-center px-4 text-[0.8125rem] font-semibold whitespace-nowrap transition duration-300 ease-out-soft',
              item.active
                ? 'bg-ink text-white shadow-[inset_0_1px_0_rgb(255_255_255/0.08)]'
                : 'bg-card text-text shadow-[inset_0_0_0_1px_var(--color-line)] hover:shadow-[inset_0_0_0_1px_rgb(28_24_21/0.25)]',
            ]}
          >
            {item.label}
          </a>
        </li>
      ))
    }
  </ul>
</nav>
