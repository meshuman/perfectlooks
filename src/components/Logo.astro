---
// looksmenu logo: the menu mark on a crimson badge, then the name. The footer version is larger.
import { menuMark } from '@/data/brand-marks.mjs';
import { defaultShop as shop } from '@/data/shop';
import { useI18n } from '@/i18n';
const { t, l } = useI18n(Astro.url);

interface Props {
  tone?: 'dark' | 'light';
  /** md: header. lg: footer, larger. */
  size?: 'md' | 'lg';
}

const { tone = 'light', size = 'md' } = Astro.props;
// On dark backgrounds the badge is white with the mark cut out in ink, and the name is white.
const dark = tone === 'dark';
---

<a href={l('/')} class:list={['inline-flex items-center', size === 'md' && 'min-h-11', size === 'lg' ? 'gap-3.5' : 'gap-2.5']}>
  <svg
    viewBox="0 0 100 100"
    class:list={['shrink-0 rounded-[0.35rem]', size === 'lg' ? 'size-14' : 'size-9', dark ? 'bg-white' : 'bg-brand']}
    aria-hidden="true"
    set:html={menuMark(dark ? '#111111' : '#ffffff')}
  />
  <span
    aria-hidden="true"
    class:list={['font-bold leading-none tracking-[-0.02em]', size === 'lg' ? 'text-[1.75rem]' : 'text-[1.3125rem]', dark ? 'text-white' : 'text-ink']}
  >
    looks<span class={dark ? 'text-gold' : 'text-brand'}>menu</span>
  </span>
  <span class="sr-only">{t('site.homeLink', { shop: shop.name })}</span>
</a>
