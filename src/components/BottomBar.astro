---
import Icon from './Icon.astro';
import type { IconName } from '@/data/icons';
import { useI18n } from '@/i18n';
const { t, l } = useI18n(Astro.url);

export type Tab = 'home' | 'learn' | 'favourites' | 'my-look';

interface Props {
  active?: Tab;
}

const { active } = Astro.props;

const tabs: { id: Tab; label: string; href: string; icon: IconName; counter?: string }[] = [
  { id: 'home', label: t('nav.home'), href: l('/'), icon: 'home' },
  { id: 'learn', label: t('nav.learn'), href: l('/learn'), icon: 'book' },
  { id: 'favourites', label: t('nav.favourites'), href: l('/favourites'), icon: 'heart', counter: 'favourites' },
  { id: 'my-look', label: t('nav.myLook'), href: l('/my-look'), icon: 'user', counter: 'my-look' },
];
---

{/* Flat tab bar with a hairline top edge. Pages keep 5rem clear at the bottom. */}
<nav aria-label={t('nav.main')} class="pb-safe fixed inset-x-0 bottom-0 z-40 bg-paper shadow-[inset_0_1px_0_var(--color-line)]">
  <ul class="mx-auto grid h-16 max-w-md grid-cols-4">
    {
      tabs.map((tab) => {
        const isActive = tab.id === active;
        return (
          <li>
            <a
              href={tab.href}
              aria-current={isActive ? 'page' : undefined}
              class:list={[
                'relative flex h-full flex-col items-center justify-center gap-1 text-[0.6875rem] tracking-wide transition-colors duration-300',
                isActive ? 'font-semibold text-ink' : 'text-muted hover:text-ink',
              ]}
            >
              {isActive && <span class="absolute top-0 h-0.5 w-10 bg-ink" />}
              <span class="relative">
                <Icon name={tab.icon} size={21} strokeWidth={isActive ? 1.75 : 1.4} />
                {tab.counter && (
                  <span
                    data-counter={tab.counter}
                    hidden
                    class="absolute -top-1.5 -right-2.5 grid h-4 min-w-4 place-items-center rounded-full bg-ink px-1 text-[0.625rem] leading-none font-semibold text-white"
                  />
                )}
              </span>
              {tab.label}
            </a>
          </li>
        );
      })
    }
  </ul>
</nav>
