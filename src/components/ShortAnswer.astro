---
import { useI18n } from '@/i18n';
const { t } = useI18n(Astro.url);
interface Props {
  text: string;
}

const { text } = Astro.props;
---

<aside class="shell">
  <div class="core relative overflow-hidden p-5 pl-6">
    <span class="absolute inset-y-0 left-0 w-1 bg-ink" aria-hidden="true"></span>
    <p class="tag">{t('learn.shortAnswer')}</p>
    <p class="mt-2 text-[1.1875rem] leading-[1.5] font-medium">{text}</p>
  </div>
</aside>
