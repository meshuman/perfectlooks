---
interface Props {
  eyebrow?: string;
  title: string;
  /** Words appended to the title. Kept for callers; the flat theme sets them like the rest of the title. */
  accent?: string;
  text?: string;
  tone?: 'dark' | 'light';
  as?: 'h1' | 'h2';
  align?: 'left' | 'center';
  link?: { href: string; label: string };
}

const { eyebrow, title, accent, text, tone = 'light', as: Heading = 'h2', align = 'left', link } = Astro.props;
---

<div class:list={['flex items-end gap-4', align === 'center' ? 'justify-center text-center' : 'justify-between']}>
  <div class:list={['max-w-xl', align === 'center' && 'mx-auto']}>
    {eyebrow && <p class={tone === 'dark' ? 'tag-dark' : 'tag'}>{eyebrow}</p>}
    <Heading class:list={['mt-2', Heading === 'h1' ? 'text-[2.25rem]' : 'text-[1.75rem]', tone === 'dark' && 'text-white']}>
      {title}{accent}
    </Heading>
    {text && <p class:list={['mt-3 text-[0.9375rem]', tone === 'dark' ? 'text-muted-dark' : 'text-muted']}>{text}</p>}
  </div>
  {
    link && (
      <a
        href={link.href}
        class:list={['shrink-0 pb-1 text-sm font-medium underline underline-offset-4', tone === 'dark' ? 'text-white' : 'text-ink']}
      >
        {link.label}
      </a>
    )
  }
</div>
