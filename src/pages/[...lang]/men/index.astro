---
// /men: the men's menu. Same layout as /women: heading, the tile grid, the guides row, and a link to the other side.
import BaseLayout from '@/layouts/BaseLayout.astro';
import FaceShapes from '@/components/FaceShapes.astro';
import Icon from '@/components/Icon.astro';
import JsonLd from '@/components/JsonLd.astro';
import MenuTiles from '@/components/MenuTiles.astro';
import { WOMEN_LIVE } from '@/data/flags';
import { breadcrumbs } from '@/data/seo';
import { defaultShop as shop } from '@/data/shop';
import { langParams, useI18n } from '@/i18n';

export function getStaticPaths() {
  return langParams().map((params) => ({ params }));
}

const { t, l } = useI18n(Astro.url);
const rowClass = 'group flex items-center gap-4 bg-paper-2 p-4 transition duration-300 ease-out-soft hover:bg-line';
---

<BaseLayout title={t('men.title')} description={t('men.description', { shop: shop.name })} tab="home">
  <JsonLd slot="head" data={breadcrumbs([{ name: t('site.home'), path: l('/') }, { name: t('men.heading'), path: l('/men') }], Astro.site!)} />
  <main>
    <section class="wrap pt-8 pb-8 md:pb-10">
      <p class="tag">{t('men.kicker')}</p>
      <h1 class="mt-3 text-[2.25rem] leading-tight">{t('men.heading')}</h1>
      <p class="mt-3 max-w-xl text-[1.0625rem] leading-relaxed text-muted">{t('men.intro')}</p>
    </section>

    <section id="browse" class="wrap scroll-mt-20 pb-10 md:pb-14">
      <MenuTiles who="men" />
    </section>

    <section class="wrap pb-10 md:pb-14">
      <FaceShapes />
    </section>

    <section class="wrap grid gap-3 pb-16 md:grid-cols-2 md:pb-24">
      <a href={l('/men/learn')} class={rowClass} data-reveal>
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ink text-white">
          <Icon name="book" size={22} strokeWidth={1.5} />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[1.0625rem] font-semibold">{t('learn.menLink')}</span>
          <span class="block text-[0.8125rem] text-muted">{t('learn.hubMenText')}</span>
        </span>
        <Icon name="arrowRight" size={20} strokeWidth={1.25} class="shrink-0 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
      </a>
      {
        WOMEN_LIVE && (
          <a href={l('/women')} class={rowClass} data-reveal>
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ink text-white">
              <Icon name="sparkle" size={22} strokeWidth={1.5} />
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-[1.0625rem] font-semibold">{t('who.women')}</span>
              <span class="block text-[0.8125rem] text-muted">{t('who.womenText')}</span>
            </span>
            <Icon name="arrowRight" size={20} strokeWidth={1.25} class="shrink-0 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
          </a>
        )
      }
    </section>
  </main>
</BaseLayout>
