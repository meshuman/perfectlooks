---
// The Learn hub: pick men's or women's guides.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getPosts } from '@/data/learn';
import { WOMEN_LIVE } from '@/data/flags';
import { womenGuides } from '@/data/women-learn';
import { breadcrumbs } from '@/data/seo';
import { langParams, useI18n } from '@/i18n';

export function getStaticPaths() {
  return langParams().map((params) => ({ params }));
}

const { t, l } = useI18n(Astro.url);
const menGuides = (await getPosts()).length;
const cards = [
  { href: l('/men/learn'), title: t('learn.hubMen'), text: t('learn.hubMenText'), count: menGuides, icon: 'scissors' as const },
  { href: l('/women/learn'), title: t('learn.hubWomen'), text: t('learn.hubWomenText'), count: womenGuides.length, icon: 'sparkle' as const },
].filter((c) => WOMEN_LIVE || !c.href.includes('/women/'));
---

<BaseLayout title={t('learn.hubTitle')} description={t('learn.hubDescription')} tab="learn">
  <JsonLd slot="head" data={breadcrumbs([{ name: t('site.home'), path: l('/') }, { name: t('learn.hubHeading'), path: l('/learn') }], Astro.site!)} />
  <main class="wrap max-w-3xl pt-6 pb-16">
    <p class="tag">{t('learn.kicker')}</p>
    <h1 class="mt-3 text-[2.25rem] leading-tight">{t('learn.hubHeading')}</h1>
    <p class="mt-3 text-[1.0625rem] leading-relaxed text-muted">{t('learn.hubIntro')}</p>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2 sm:gap-5">
      {
        cards.map((card, n) => (
          <li data-reveal style={`--reveal-delay:${n * 70}ms`}>
            <a href={card.href} class="group flex h-full flex-col gap-4 bg-card p-5 shadow-[inset_0_0_0_1px_var(--color-line)] transition duration-300 ease-out-soft hover:shadow-[inset_0_0_0_2px_var(--color-ink)]">
              <span class="grid size-12 place-items-center rounded-full bg-ink text-white">
                <Icon name={card.icon} size={22} strokeWidth={1.5} />
              </span>
              <span class="flex-1">
                <span class="block text-[1.25rem] font-semibold">{card.title}</span>
                <span class="mt-1 block text-[0.9375rem] leading-snug text-muted">{card.text}</span>
              </span>
              <span class="flex items-center justify-between text-[0.8125rem] font-semibold">
                {t('wlearn.count', { count: String(card.count) })}
                <Icon name="arrowRight" size={20} strokeWidth={1.25} class="transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </main>
</BaseLayout>
