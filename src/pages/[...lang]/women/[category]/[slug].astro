---
import { WOMEN_LIVE } from '@/data/flags';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import ItemPhoto from '@/components/ItemPhoto.astro';
import JsonLd from '@/components/JsonLd.astro';
import { womenCategories, womenServiceId, serviceFaces } from '@/data/women';
import { FACE_SHAPES } from '@/data/faces';
import { whatsappNumber } from '@/data/feedback';
import { defaultShop as shop } from '@/data/shop';
import { breadcrumbs } from '@/data/seo';
import { langParams, useI18n, type UiKey } from '@/i18n';

export function getStaticPaths() {
  return (WOMEN_LIVE ? langParams() : []).flatMap(({ lang }) =>
    womenCategories.flatMap((category) => category.items.map((slug) => ({ params: { lang, category: category.key, slug }, props: { category, slug } }))),
  );
}

const { category, slug } = Astro.props;
const { t, l } = useI18n(Astro.url);
const k = (field: string) => `wsvc.${slug}.${field}` as UiKey;
const name = t(k('name'));
const categoryLabel = t(`wcat.${category.key}.label` as UiKey);
const faces = serviceFaces(slug);
const allFaces = faces?.length === 5;
const message = encodeURIComponent(t('addons.askMessage', { name }));
---

<BaseLayout title={`${name} · ${categoryLabel}`} description={`${t(k('line'))} ${t(k('good'))}`} back={{ href: l(`/women/${category.key}`), label: categoryLabel }}>
  <JsonLd
    slot="head"
    data={breadcrumbs(
      [
        { name: t('site.home'), path: l('/') },
        { name: t('women.heading'), path: l('/women') },
        { name: categoryLabel, path: l(`/women/${category.key}`) },
        { name, path: l(`/women/${category.key}/${slug}`) },
      ],
      Astro.site!,
    )}
  />
  <main class="wrap pt-4 pb-24 md:grid md:grid-cols-2 md:gap-10 md:pt-8 lg:gap-14">
    <div class="md:sticky md:top-20 md:self-start">
      <div class="relative aspect-square overflow-hidden">
        <ItemPhoto item={{ id: womenServiceId(slug), name, mainPhoto: 'front' }} block={category.block} size="hero" class="size-full" />
      </div>
    </div>
    <div class="mt-6 md:mt-0">
      <div class="flex items-center gap-4">
        <span class="grid size-16 shrink-0 place-items-center rounded-full bg-ink text-white">
          <Icon name={category.icon} size={28} strokeWidth={1.5} />
        </span>
        <div>
          <p class="tag">{categoryLabel}</p>
          <h1 class="mt-1 text-[2rem] leading-tight">{name}</h1>
        </div>
      </div>
      <p class="mt-5 text-[1.1875rem] leading-snug font-medium">{t(k('line'))}</p>


      <section class="mt-10">
        <h2 class="eyebrow">{t('addons.whatLabel')}</h2>
        <p class="mt-2 text-[1.0625rem] leading-relaxed">{t(k('what'))}</p>
      </section>

      <section class="mt-10">
        <h2 class="eyebrow">{t('addons.whyLabel')}</h2>
        <p class="mt-2 text-[1.0625rem] leading-relaxed">{t(k('why'))}</p>
      </section>

      <section class="mt-10">
        <h2 class="eyebrow">{t('wdetail.stepsLabel')}</h2>
        <ol class="mt-3 space-y-4">
          {
            ['step1', 'step2', 'step3'].map((step, n) => (
              <li class="flex gap-4">
                <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand text-sm font-bold text-white">{n + 1}</span>
                <p class="pt-0.5 text-[1.0625rem] leading-snug">{t(k(step))}</p>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="mt-10 grid gap-3 sm:grid-cols-2">
        <div class="bg-paper-2 p-5">
          <h2 class="text-xs font-semibold tracking-[0.14em] text-muted uppercase">{t('wdetail.suitsLabel')}</h2>
          <p class="mt-2 text-[1rem] leading-snug">{t(k('suits'))}</p>
          <p class="mt-2 text-[0.9375rem] leading-snug text-muted">{t(k('good'))}</p>
        </div>
        <div class="bg-paper-2 p-5">
          <h2 class="text-xs font-semibold tracking-[0.14em] text-muted uppercase">{t('addons.askLabel')}</h2>
          <p class="mt-2 text-[1rem] leading-snug">{t(k('ask'))}</p>
        </div>
      </section>

      {
        faces && (
          <section class="mt-10">
            <h2 class="eyebrow">{t('wdetail.faceLabel')}</h2>
            {allFaces ? (
              <p class="mt-2 text-[1.0625rem] leading-snug">{t('wdetail.faceAll')}</p>
            ) : (
              <ul class="mt-3 flex flex-wrap gap-2">
                {faces.map((face) => (
                  <li class="inline-flex h-10 items-center gap-2 bg-paper-2 px-3.5 text-[0.875rem] font-semibold">
                    <svg viewBox="0 0 40 48" class="h-5 w-[1.0625rem]" fill="none" stroke="currentColor" stroke-width="3" stroke-linejoin="round" aria-hidden="true">
                      <path d={FACE_SHAPES.find((x) => x.value === face)!.shape} />
                    </svg>
                    {t(`face.${face}` as UiKey)}
                  </li>
                ))}
              </ul>
            )}
          </section>
        )
      }
      <section class="mt-10">
        <h2 class="eyebrow">{t('wdetail.dailyLabel')}</h2>
        <ul class="mt-3 space-y-3">
          {
            [1, 2, 3].map((n) => (
              <li class="flex gap-3">
                <Icon name="check" size={18} strokeWidth={2} class="mt-1 shrink-0 text-brand" />
                <p class="text-[1.0625rem] leading-snug">{t(`wdaily.${category.key}.${n}` as UiKey)}</p>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="mt-10 core p-5">
        <h2 class="eyebrow">{t('wdetail.timeCareLabel')}</h2>
        <dl class="mt-3 grid grid-cols-2 gap-px bg-line">
          <div class="bg-paper p-4">
            <dt class="flex items-center gap-1.5 text-xs text-muted"><Icon name="clock" size={14} />{t('wdetail.takes')}</dt>
            <dd class="mt-1 text-[1.0625rem] font-semibold">{t(k('time'))}</dd>
          </div>
          <div class="bg-paper p-4">
            <dt class="flex items-center gap-1.5 text-xs text-muted"><Icon name="calendar" size={14} />{t('wdetail.repeat')}</dt>
            <dd class="mt-1 text-[1.0625rem] font-semibold">{t(k('often'))}</dd>
          </div>
        </dl>
        <p class="mt-4 text-[1rem] leading-relaxed">{t(k('care'))}</p>
      </section>

      <section class="mt-12 bg-ink p-6 text-white">
        <h2 class="text-[1.375rem] leading-snug">{t('addons.ask')}</h2>
        <p class="mt-2 text-[0.9375rem] text-muted-dark">{t('addons.askText')}</p>
        <a href={`https://wa.me/${whatsappNumber}?text=${message}`} target="_blank" rel="noopener" class="mt-5 inline-flex h-12 items-center gap-2 bg-brand px-5 text-[0.9375rem] font-semibold text-white">
          <Icon name="message" size={18} />
          {t('addons.ask')}
        </a>
        <a href={`tel:${shop.phone}`} class="mt-2 flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium text-white underline underline-offset-4">
          <Icon name="phone" size={16} />
          {shop.phoneDisplay}
        </a>
      </section>

      <p class="mt-6 text-sm text-muted">{t('addons.care')}</p>
      <a href={l(`/women/${category.key}`)} class="mt-4 inline-flex min-h-11 items-center gap-2 text-[0.9375rem] font-semibold">
        <Icon name="arrowLeft" size={16} />
        {categoryLabel}
      </a>
    </div>
  </main>
</BaseLayout>
