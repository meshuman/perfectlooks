---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
import JsonLd from '@/components/JsonLd.astro';
import { guideIcon, womenGuides } from '@/data/women-learn';
import { whatsappNumber } from '@/data/feedback';
import { defaultShop as shop } from '@/data/shop';
import { breadcrumbs } from '@/data/seo';
import { langParams, useI18n, type UiKey } from '@/i18n';

export function getStaticPaths() {
  return langParams().flatMap(({ lang }) => womenGuides.map((guide, n) => ({ params: { lang, slug: guide.slug }, props: { guide, next: womenGuides[(n + 1) % womenGuides.length]! } })));
}

const { guide, next } = Astro.props;
const { t, l } = useI18n(Astro.url);
const k = (slug: string, field: string) => `wguide.${slug}.${field}` as UiKey;
const title = t(k(guide.slug, 'title'));
const message = encodeURIComponent(t('wlearn.askMessage', { name: title }));
---

<BaseLayout title={title} description={t(k(guide.slug, 'answer'))} tab="learn" back={{ href: l('/women/learn'), label: t('wlearn.heading') }}>
  <JsonLd
    slot="head"
    data={breadcrumbs(
      [
        { name: t('site.home'), path: l('/') },
        { name: t('wlearn.heading'), path: l('/women/learn') },
        { name: title, path: l(`/women/learn/${guide.slug}`) },
      ],
      Astro.site!,
    )}
  />
  <main class="wrap max-w-2xl pt-6 pb-24">
    <div class="flex items-center gap-4">
      <span class="grid size-14 shrink-0 place-items-center rounded-full bg-ink text-white">
        <Icon name={guideIcon[guide.topic]} size={24} strokeWidth={1.5} />
      </span>
      <div>
        <p class="tag">{t(`wlearn.topic.${guide.topic}` as UiKey)}</p>
        <p class="mt-1 text-xs text-muted">{t('detail.minRead', { minutes: guide.minutes })}</p>
      </div>
    </div>
    <h1 class="mt-5 text-[2rem] leading-tight">{title}</h1>

    <section class="mt-8 bg-paper-2 p-5">
      <h2 class="eyebrow">{t('wlearn.answer')}</h2>
      <p class="mt-2 text-[1.125rem] leading-snug font-medium">{t(k(guide.slug, 'answer'))}</p>
    </section>

    <section class="mt-10">
      <h2 class="eyebrow">{t('wlearn.tips')}</h2>
      <ol class="mt-3 space-y-4">
        {
          ['tip1', 'tip2', 'tip3', 'tip4'].map((tip, n) => (
            <li class="flex gap-4">
              <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand text-sm font-bold text-white">{n + 1}</span>
              <p class="pt-0.5 text-[1.0625rem] leading-snug">{t(k(guide.slug, tip))}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section class="mt-12 bg-ink p-6 text-white">
      <h2 class="text-[1.375rem] leading-snug">{t('wlearn.ask')}</h2>
      <p class="mt-2 text-[0.9375rem] text-muted-dark">{t('wlearn.askText')}</p>
      <a href={`https://wa.me/${whatsappNumber}?text=${message}`} target="_blank" rel="noopener" class="mt-5 inline-flex h-12 items-center gap-2 bg-brand px-5 text-[0.9375rem] font-semibold text-white transition duration-300 ease-out-soft active:scale-[0.99]">
        <Icon name="message" size={18} />
        {t('wlearn.ask')}
      </a>
      <a href={`tel:${shop.phone}`} class="mt-2 flex min-h-11 items-center gap-2 text-[0.9375rem] font-medium text-white underline underline-offset-4">
        <Icon name="phone" size={16} />
        {shop.phoneDisplay}
      </a>
    </section>

    <a href={l(`/women/learn/${next.slug}`)} class="group mt-8 flex items-center justify-between gap-4 border-t border-line py-5">
      <span>
        <span class="eyebrow block">{t('wlearn.next')}</span>
        <span class="mt-1 block text-[1.0625rem] font-semibold">{t(k(next.slug, 'title'))}</span>
      </span>
      <Icon name="arrowRight" size={20} strokeWidth={1.25} class="shrink-0 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
    </a>
  </main>
</BaseLayout>
