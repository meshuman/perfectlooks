---
// /play/<game>: one game, with how to play and its rules above the board.
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import MergeGame from '@/components/islands/MergeGame';
import MemoryGame from '@/components/islands/MemoryGame';
import StyleQuiz from '@/components/islands/StyleQuiz';
import { getClientItems } from '@/data/catalogue';
import { games, type Game } from '@/data/games';
import { breadcrumbs } from '@/data/seo';
import { langParams, useI18n, type UiKey } from '@/i18n';

export function getStaticPaths() {
  return langParams().flatMap(({ lang }) => games.map((game) => ({ params: { lang, game: game.slug }, props: { game } })));
}

interface Props {
  game: Game;
}

const { game } = Astro.props;
const i = useI18n(Astro.url);
const { t, l } = i;
const k = (field: string) => `game.${game.slug}.${field}` as UiKey;
const title = t(k('title'));
const rules = Array.from({ length: game.rules }, (_, n) => t(k(`r${n + 1}`)));

// The quiz uses catalogue photos: haircuts and ready looks that have one, spread evenly so every kind shows up.
let pool: { name: string; photo: string; kind: string }[] = [];
if (game.slug === 'quiz') {
  const withPhoto = (await getClientItems(i, [])).filter((it) => it.photo && (it.category === 'hair' || it.category === 'looks'));
  const step = Math.max(1, Math.floor(withPhoto.length / 60));
  pool = withPhoto.filter((_, n) => n % step === 0).map((it) => ({ name: it.name, photo: it.photo!.large, kind: it.category }));
}
---

<BaseLayout title={title} description={t(k('line'))} tab="play" back={{ href: l('/play'), label: t('play.hubTitle') }}>
  <JsonLd
    slot="head"
    data={breadcrumbs(
      [
        { name: t('site.home'), path: l('/') },
        { name: t('play.hubTitle'), path: l('/play') },
        { name: title, path: l(`/play/${game.slug}`) },
      ],
      Astro.site!,
    )}
  />
  <main class="wrap pt-6 pb-24">
    <div class="mx-auto max-w-md">
      <p class="tag">{t('play.hubHeading')}</p>
      <h1 class="mt-3 text-[2.25rem] leading-tight">{title}</h1>
      <p class="mt-2 text-[0.9375rem] text-muted">{t(k('line'))}</p>

      {/* How to play: open on arrival, and it folds away once you know the game. */}
      <details open class="mt-5 bg-paper-2">
        <summary class="flex min-h-12 cursor-pointer items-center justify-between gap-3 px-4 text-[0.9375rem] font-semibold">
          {t('play.howTitle')}
        </summary>
        <ol class="space-y-2 px-4 pb-4 text-[0.9375rem] leading-snug">
          {
            rules.map((rule, n) => (
              <li class="flex gap-3">
                <span class="grid size-6 shrink-0 place-items-center rounded-full bg-ink text-[0.75rem] font-semibold text-white" aria-hidden="true">{n + 1}</span>
                <span>{rule}</span>
              </li>
            ))
          }
        </ol>
      </details>
    </div>

    {game.slug === 'merge' && <MergeGame client:only="preact" />}
    {game.slug === 'memory' && <MemoryGame client:only="preact" />}
    {game.slug === 'quiz' && <StyleQuiz client:only="preact" pool={pool} browseHref={l('/men/hair')} />}
  </main>
</BaseLayout>
