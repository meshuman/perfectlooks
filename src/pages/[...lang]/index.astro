---
// The landing page: the brand, one question (men or women?), and what is the same for everyone.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import ItemPhoto from '@/components/ItemPhoto.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getAllItems } from '@/data/catalogue';
import { website } from '@/data/seo';
import { defaultShop as shop } from '@/data/shop';
import { womenCategories } from '@/data/women';
import { kgfBlock, scissorsMark } from '@/data/brand-marks.mjs';
import { langParams, useI18n } from '@/i18n';

export function getStaticPaths() {
  return langParams().map((params) => ({ params }));
}

const i = useI18n(Astro.url);
const { t, l } = i;

// Hair, beards, moustaches and colours; Ready Looks are counted on their own.
const styleCount = (await getAllItems()).filter((it) => it.category !== 'looks').length;
const womenServices = womenCategories.reduce((sum, category) => sum + category.items.length, 0);
---

<BaseLayout
  title={t('home.title', { shop: shop.name, area: shop.area })}
  description={t('home.description', { shop: shop.name, area: shop.area })}
  tab="home"
>
  <JsonLd slot="head" data={website(Astro.site!)} />
  <main>
    {/* Split hero: KGF brand logo on crimson red, then the message. Side by side from tablet up. */}
    <section class="md:grid md:min-h-[34rem] md:grid-cols-2">
      <div class="relative aspect-[16/8] overflow-hidden md:aspect-auto">
        <div class="absolute inset-0 flex flex-col items-center justify-center gap-5 bg-brand p-6 text-white md:gap-7">
          <svg viewBox="0 0 100 100" class="h-20 max-h-[48%] w-auto md:h-44" aria-hidden="true" set:html={scissorsMark()} />
          <div class="w-36 max-w-[55%] md:w-52" set:html={kgfBlock()} />
        </div>
      </div>
      <div class="wrap flex flex-col justify-center py-7 md:max-w-xl md:px-12 md:py-20">
        <p class="tag rise">{shop.name} · {shop.area}</p>
        <h1 class="rise mt-3 text-[2.375rem] leading-[1.1] md:text-[3.25rem]" style="--rise-delay:80ms">
          {t('home.heading')}
        </h1>
        <p class="rise mt-4 max-w-md text-[0.9375rem] leading-relaxed text-muted" style="--rise-delay:160ms">
          {t('home.intro')}
        </p>
      </div>
    </section>

    {/* The one question: who is it for? Each card opens that section. */}
    <section id="who" class="wrap scroll-mt-20 py-8 md:py-20" aria-labelledby="who-title" data-reveal>
      <h2 id="who-title" class="text-[1.75rem] leading-tight">{t('who.title')}</h2>
      <p class="mt-1 text-[0.9375rem] text-muted">{t('who.text')}</p>
      <div class="mt-6 grid gap-3 md:grid-cols-2 md:gap-5">
        <a href={l('/men')} class="group flex flex-col bg-card shadow-[inset_0_0_0_1px_var(--color-line)] transition duration-300 ease-out-soft hover:shadow-[inset_0_0_0_2px_var(--color-ink)]">
          <span class="relative block aspect-[16/9] overflow-hidden">
            <ItemPhoto
              item={{ id: 'H07', name: 'Low Fade', mainPhoto: 'side' }}
              decorative
              class="absolute inset-0 size-full object-[center_28%] transition-transform duration-700 ease-out-soft group-hover:scale-[1.03]"
            />
          </span>
          <span class="flex items-center justify-between gap-3 p-4">
            <span>
              <span class="block text-[1.375rem] font-semibold">{t('who.men')}</span>
              <span class="mt-0.5 block text-[0.875rem] leading-snug text-muted">{t('who.menText')}</span>
              <span class="mt-1 block text-[0.8125rem] font-semibold">{t('men.styleCount', { count: String(styleCount) })}</span>
            </span>
            <Icon name="arrowRight" size={22} strokeWidth={1.25} class="shrink-0 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
          </span>
        </a>
        <a href={l('/women')} class="group flex flex-col bg-card shadow-[inset_0_0_0_1px_var(--color-line)] transition duration-300 ease-out-soft hover:shadow-[inset_0_0_0_2px_var(--color-ink)]">
          <span class="relative grid aspect-[16/9] place-items-center overflow-hidden bg-block-blush text-ink">
            <Icon name="sparkle" size={64} strokeWidth={1} class="transition-transform duration-700 ease-out-soft group-hover:scale-110" />
          </span>
          <span class="flex items-center justify-between gap-3 p-4">
            <span>
              <span class="block text-[1.375rem] font-semibold">{t('who.women')}</span>
              <span class="mt-0.5 block text-[0.875rem] leading-snug text-muted">{t('who.womenText')}</span>
              <span class="mt-1 block text-[0.8125rem] font-semibold">{t('women.tileCount', { count: String(womenServices) })}</span>
            </span>
            <Icon name="arrowRight" size={22} strokeWidth={1.25} class="shrink-0 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
          </span>
        </a>
      </div>
    </section>

    <section class="wrap pb-12 md:pb-16" data-reveal>
      <div class="grid gap-6 border-t border-line pt-10 md:grid-cols-2">
        <div>
          <p class="tag">{t('footer.visit')}</p>
          <h2 class="mt-2 text-[1.375rem] leading-snug">{shop.name}</h2>
          <ul class="mt-3 space-y-1 text-[0.9375rem]">
            <li class="flex items-start gap-2"><Icon name="mapPin" size={16} class="mt-1 shrink-0 text-muted" /><span>{t('shop.addressValue')}</span></li>
            <li class="flex items-start gap-2"><Icon name="clock" size={16} class="mt-1 shrink-0 text-muted" /><span>{t('shop.hoursValue')}</span></li>
          </ul>
        </div>
        <div class="flex flex-wrap items-start gap-3 md:justify-end">
          <Button href={`tel:${shop.phone}`} icon="phone">{shop.phoneDisplay}</Button>
          <Button href={shop.mapUrl} variant="outline">{t('footer.directions')}</Button>
        </div>
      </div>
    </section>

    {/* An open door for customers: what they expected, and what would make the app better. */}
    <section class="wrap pb-16 md:pb-24" data-reveal>
      <a href={l('/feedback')} class="group flex items-center gap-4 bg-ink p-5 text-white md:p-7">
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand text-white">
          <Icon name="message" size={22} />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[1.125rem] leading-snug font-semibold">{t('feedback.ctaTitle')}</span>
          <span class="block text-sm text-muted-dark">{t('feedback.ctaText')}</span>
        </span>
        <Icon name="arrowRight" size={20} strokeWidth={1.25} class="shrink-0 transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
      </a>
    </section>
  </main>
</BaseLayout>
