---
// The home page. On looksmenu.com it is the product page (what looksmenu is, plans, shop registration). On a shop's own
// address (kgf.looksmenu.com) it is that shop's catalogue home. Both are in the page; the address picks which one shows
// (see the .only-main and .only-shop rules in global.css, switched by the script in BaseLayout).
import BaseLayout from '@/layouts/BaseLayout.astro';
import JsonLd from '@/components/JsonLd.astro';
import MenuHome from '@/components/MenuHome.astro';
import ProductHome from '@/components/ProductHome.astro';
import { product, website } from '@/data/seo';
import { langParams, useI18n } from '@/i18n';

export function getStaticPaths() {
  return langParams().map((params) => ({ params }));
}

const { t } = useI18n(Astro.url);
---

<BaseLayout title={t('prod.title')} description={t('prod.description')} tab="home">
  <JsonLd slot="head" data={[website(Astro.site!), product(Astro.site!, t('prod.description'))]} />
  <main>
    <div class="only-main"><ProductHome /></div>
    <div class="only-shop"><MenuHome asH1={false} /></div>
  </main>
</BaseLayout>
