---
// The landing page: choose a menu (men or women) and go straight inside. The same tile grids as /men and /women.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import ItemPhoto from '@/components/ItemPhoto.astro';
import JsonLd from '@/components/JsonLd.astro';
import MenuTiles from '@/components/MenuTiles.astro';
import { getAllItems } from '@/data/catalogue';
import { WOMEN_LIVE, womenNotifyNumber } from '@/data/flags';
import { photoFor } from '@/data/photos';
import { trendRank } from '@/data/trending';
import { website } from '@/data/seo';
import { defaultShop as shop } from '@/data/shop';
import { menuMark } from '@/data/brand-marks.mjs';
import { langParams, useI18n, type UiKey } from '@/i18n';

export function getStaticPaths() {
  return langParams().map((params) => ({ params }));
}

const { t, l } = useI18n(Astro.url);

const allItems = await getAllItems();
const styleCount = allItems.length;
// Popular right now: the most-asked-for haircuts and ready looks that already have a photo.
const popularNow = ['hair', 'looks']
  .flatMap((category) =>
    allItems
      .filter((it) => it.category === category && it.popular && photoFor(it.id))
      .sort((a, b) => trendRank(a.id) - trendRank(b.id))
      .slice(0, 5),
  )
  .sort((a, b) => (trendRank(a.id) % 5) - (trendRank(b.id) % 5));
const steps = [
  { href: '#men', icon: 'scissors' as const, label: t('home.strip1') },
  { href: l('/men/hair'), icon: 'eye' as const, label: t('home.strip2') },
  { href: l('/my-look'), icon: 'user' as const, label: t('home.strip3') },
];

const waLink = (message: string) => `https://wa.me/${womenNotifyNumber}?text=${encodeURIComponent(message)}`;
const contactWhatsapp = waLink(t('contact.whatsappMessage', { shop: shop.name }));
const notifyHref = waLink(t('who.womenNotifyMessage', { shop: shop.name }));

const sectionHead = 'flex items-end justify-between gap-4';
const seeAll = 'group inline-flex min-h-11 shrink-0 items-center gap-1.5 text-[0.9375rem] font-semibold underline-offset-4 hover:underline';
---

<BaseLayout title={t('home.title', { shop: shop.name })} description={t('home.description', { shop: shop.name })} tab="home">
  <JsonLd slot="head" data={website(Astro.site!)} />
  <main>
    {/* Announcement bar, as on the reference: one line and one link. */}
    {
      !WOMEN_LIVE && (
        <p class="bg-brand px-4 py-2.5 text-center text-[0.75rem] font-semibold tracking-[0.1em] text-white uppercase">
          {t('home.announce')}{' '}
          <a href={notifyHref} target="_blank" rel="noopener" class="underline underline-offset-4">{t('home.announceLink')}</a>
        </p>
      )
    }
    <section class="wrap pt-7 pb-6 md:pt-12 md:pb-10">
      <p class="rise inline-flex items-center gap-2 rounded-full bg-paper-2 py-1 pr-3 pl-1 text-[0.625rem] font-semibold tracking-[0.2em] uppercase">
        <svg viewBox="0 0 100 100" class="size-6 rounded-full bg-brand" aria-hidden="true" set:html={menuMark()} />
        {shop.name}
      </p>
      <h1 class="rise mt-4 max-w-2xl text-[2.25rem] leading-[1.05] md:text-[3.25rem]" style="--rise-delay:80ms">{t('home.heading')}</h1>
    </section>

    {/* Three steps, as a tinted strip of links. */}
    <section class="bg-block-sky/60" aria-label={t('home.stripLabel')}>
      <ul class="wrap grid sm:grid-cols-3">
        {
          steps.map((step) => (
            <li>
              <a href={step.href} class="flex min-h-14 items-center justify-center gap-2.5 py-3 text-[0.75rem] font-bold tracking-[0.14em] uppercase underline underline-offset-[6px] decoration-ink/40 transition duration-300 ease-out-soft hover:decoration-ink">
                <Icon name={step.icon} size={18} strokeWidth={1.5} />
                {step.label}
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Popular right now: a row of photo cards that go straight to the style. */}
    <section class="wrap pt-10 pb-10 md:pt-14 md:pb-14" aria-labelledby="popular-title">
      <div data-reveal>
        <p class="tag">{t('home.popularKicker')}</p>
        <h2 id="popular-title" class="mt-2 text-[1.75rem] leading-tight font-light tracking-[0.04em] uppercase md:text-[2.25rem]">{t('home.popularTitle')}</h2>
      </div>
      <ul class="-mx-4 mt-6 flex snap-x snap-mandatory gap-3 overflow-x-auto px-4 pb-2 [scrollbar-width:none] md:mx-0 md:gap-4 md:px-0 [&::-webkit-scrollbar]:hidden">
        {
          popularNow.map((item) => (
            <li class="w-[44%] shrink-0 snap-start sm:w-[30%] md:w-[calc((100%-4rem)/5)]">
              <a href={l(item.href)} class="group block">
                <span class="relative block aspect-[4/5] overflow-hidden">
                  <ItemPhoto item={item} decorative class="absolute inset-0 size-full transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]" />
                </span>
                <span class="mt-2.5 block text-[0.9375rem] leading-snug font-semibold">{item.name}</span>
                <span class="block text-[0.6875rem] font-bold tracking-[0.14em] text-muted uppercase">{t(`category.${item.category}.label` as UiKey)}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <div id="menu">
      {/* Men's menu: the same tiles as /men. */}
      <section id="men" class="wrap scroll-mt-20 pb-12 md:pb-16" aria-labelledby="men-title">
        <div class={sectionHead} data-reveal>
          <div>
            <p class="tag">{t('men.kicker')}</p>
            <h2 id="men-title" class="mt-2 text-[1.75rem] leading-tight font-light tracking-[0.04em] uppercase md:text-[2.25rem]">{t('home.menuMen')}</h2>
            <p class="mt-1 text-[0.9375rem] text-muted">{t('who.menText')}</p>
          </div>
          <a href={l('/men')} class={seeAll}>
            {t('home.seeAll')}
            <Icon name="arrowRight" size={18} strokeWidth={1.5} class="transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
          </a>
        </div>
        <div class="mt-6">
          <MenuTiles who="men" compact carousel />
        </div>
      </section>

      {/* A number to lean on, and the way in. */}
      <section class="wrap pb-12 md:pb-16" data-reveal>
        <div class="grid gap-6 bg-brand p-6 text-white md:grid-cols-[1fr_auto] md:items-center md:p-10">
          <div>
            <p class="tag-dark !text-white">{t('home.statKicker')}</p>
            <p class="mt-3 text-[2rem] leading-tight font-light tracking-[0.02em] uppercase md:text-[2.75rem]">{t('home.statTitle', { count: String(styleCount) })}</p>
            <p class="mt-2 max-w-lg text-[0.9375rem] text-white">{t('home.statText')}</p>
          </div>
          <Button href={l('/men')} variant="dark" size="lg" arrow>{t('home.statButton')}</Button>
        </div>
      </section>

      {/* Women's menu: the same tiles as /women once that section is live; until then a Coming soon card. */}
      <section id="women" class="wrap scroll-mt-20 pb-12 md:pb-16" aria-labelledby="women-title">
        {
          WOMEN_LIVE ? (
            <>
              <div class={sectionHead} data-reveal>
                <div>
                  <p class="tag">{t('women.kicker')}</p>
                  <h2 id="women-title" class="mt-2 text-[1.75rem] leading-tight font-light tracking-[0.04em] uppercase md:text-[2.25rem]">{t('home.menuWomen')}</h2>
                  <p class="mt-1 text-[0.9375rem] text-muted">{t('who.womenText')}</p>
                </div>
                <a href={l('/women')} class={seeAll}>
                  {t('home.seeAll')}
                  <Icon name="arrowRight" size={18} strokeWidth={1.5} class="transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
                </a>
              </div>
              <div class="mt-6">
                <MenuTiles who="women" compact carousel />
              </div>
            </>
          ) : (
            <div class="grid gap-5 bg-paper-2 p-4 md:grid-cols-[18rem_1fr] md:items-center md:gap-8 md:p-5" data-reveal>
              <span class="relative block aspect-[3/2] overflow-hidden md:aspect-[4/3]">
                <ItemPhoto
                  item={{ id: 'W05', name: 'Blow Dry & Styling', mainPhoto: 'front' }}
                  decorative
                  block="bg-block-blush"
                  class="absolute inset-0 size-full object-[center_20%] opacity-60 saturate-50"
                />
                <span class="absolute top-3 left-3 rounded-full bg-ink px-3 py-1.5 text-[0.6875rem] font-semibold tracking-[0.14em] text-white uppercase">{t('who.womenSoon')}</span>
              </span>
              <div>
                <h2 id="women-title" class="text-[1.75rem] leading-tight">{t('home.menuWomen')}</h2>
                <p class="mt-1 text-[0.9375rem] text-muted">{t('who.womenText')}</p>
                <p class="mt-3 max-w-md text-[0.9375rem] text-text">{t('who.womenSoonText')}</p>
                <div class="mt-4">
                  <Button href={notifyHref} variant="dark" size="lg" arrow target="_blank" rel="noopener">{t('who.womenNotify')}</Button>
                </div>
              </div>
            </div>
          )
        }
      </section>
    </div>

    {/* More to explore: three image cards, each with a text link. */}
    <section class="wrap pb-12 md:pb-16" aria-labelledby="more-title">
      <div data-reveal>
        <p class="tag">{t('home.moreKicker')}</p>
        <h2 id="more-title" class="mt-2 text-[1.75rem] leading-tight font-light tracking-[0.04em] uppercase md:text-[2.25rem]">{t('home.moreTitle')}</h2>
      </div>
      <ul class="mt-6 grid gap-5 md:grid-cols-2">
        {
          [
            { href: l('/learn'), title: t('nav.learn'), text: t('learn.hubMenText'), photo: { id: 'B05', name: 'Full Beard', mainPhoto: 'front' as const }, block: 'bg-block-sand' },
            { href: l('/play'), title: t('play.hubTitle'), text: t('home.cardPlay'), icon: 'puzzle' as const, block: 'bg-block-sky' },
          ].map((card, n) => (
            <li data-reveal style={`--reveal-delay:${n * 70}ms`}>
              <a href={card.href} class="group block">
                <span class:list={['relative block aspect-[3/2] overflow-hidden', card.icon && card.block]}>
                  {card.photo ? (
                    <ItemPhoto item={card.photo} decorative block={card.block} class="absolute inset-0 size-full transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]" />
                  ) : (
                    <span class="absolute inset-0 grid place-items-center text-ink">
                      <Icon name={card.icon!} size={56} strokeWidth={1.25} class="transition-transform duration-500 ease-out-soft group-hover:scale-110" />
                    </span>
                  )}
                </span>
                <span class="mt-3 block text-[1.25rem] font-semibold">{card.title}</span>
                <span class="mt-1 block text-[0.9375rem] leading-snug text-muted">{card.text}</span>
                <span class="mt-2 inline-flex min-h-11 items-center gap-1.5 text-[0.75rem] font-bold tracking-[0.14em] uppercase underline decoration-brand decoration-2 underline-offset-[6px]">
                  {t('home.explore')}
                  <Icon name="arrowRight" size={16} strokeWidth={1.5} class="transition-transform duration-300 ease-out-soft group-hover:translate-x-1" />
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    {/* Contact. */}
    <section class="wrap pb-12 md:pb-16" data-reveal>
      <div class="bg-ink p-1.5">
        <div class="grid gap-8 bg-ink p-6 text-white shadow-[inset_0_0_0_1px_rgb(255_255_255/0.14)] md:grid-cols-2 md:items-center md:p-10">
          <div>
            <p class="inline-flex rounded-full bg-white/10 px-3 py-1.5 text-[0.625rem] font-semibold tracking-[0.2em] uppercase">{t('footer.visit')}</p>
            <h2 class="mt-4 text-[1.75rem] leading-tight md:text-[2.25rem]">{shop.name}</h2>
            <p class="mt-4 max-w-sm text-[0.9375rem] text-muted-dark">{t('contact.tagline')}</p>
          </div>
          <div class="flex flex-wrap gap-3 md:justify-end">
            <Button href={`tel:${shop.phone}`} icon="phone" variant="outline-dark" size="lg">{shop.phoneDisplay}</Button>
            <Button href={contactWhatsapp} variant="outline-dark" size="lg" arrow target="_blank" rel="noopener">{t('contact.whatsapp')}</Button>
          </div>
        </div>
      </div>
    </section>

    {/* An open door for customers: what they expected, and what would make the app better. */}
    <section class="wrap pb-16 md:pb-24" data-reveal>
      <a href={l('/feedback')} class="group flex items-center gap-4 bg-paper-2 p-5 transition duration-500 ease-out-soft hover:bg-line md:p-7">
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand text-white">
          <Icon name="message" size={22} />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[1.125rem] leading-snug font-semibold">{t('feedback.ctaTitle')}</span>
          <span class="block text-sm text-muted">{t('feedback.ctaText')}</span>
        </span>
        <Icon name="arrowRight" size={20} strokeWidth={1.25} class="shrink-0 transition-transform duration-500 ease-out-soft group-hover:translate-x-1" />
      </a>
    </section>
  </main>
</BaseLayout>
