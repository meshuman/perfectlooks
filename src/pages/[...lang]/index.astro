---
// The landing page: the brand, one question (men or women?), and the shop's details.
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import Icon from '@/components/Icon.astro';
import ItemPhoto from '@/components/ItemPhoto.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getAllItems } from '@/data/catalogue';
import { WOMEN_LIVE, womenNotifyNumber } from '@/data/flags';
import { website } from '@/data/seo';
import { defaultShop as shop } from '@/data/shop';
import { womenCategories } from '@/data/women';
import { addons } from '@/data/addons';
import { menuMark } from '@/data/brand-marks.mjs';
import { langParams, useI18n, type UiKey } from '@/i18n';

export function getStaticPaths() {
  return langParams().map((params) => ({ params }));
}

const { t, l } = useI18n(Astro.url);

// Hair, beards, moustaches and colours; Ready Looks are counted on their own.
const allItems = await getAllItems();
const styleCount = allItems.filter((it) => it.category !== 'looks').length;
const countOf = (category: string) => allItems.filter((it) => it.category === category).length;
const womenServices = womenCategories.reduce((sum, category) => sum + category.items.length, 0);

// The hero is a menu: the looks to browse and the services that go with them, each with its count.
const menuLooks = ['hair', 'beards', 'moustaches', 'colours', 'looks'].map((key) => ({
  href: l(`/men/${key}`),
  label: t(`category.${key}.label` as UiKey),
  count: String(countOf(key)),
}));
const menuServices = [
  { href: l('/men/add-ons'), label: t('addons.link'), count: String(addons.length) },
  { href: WOMEN_LIVE ? l('/women') : undefined, label: t('who.women'), count: WOMEN_LIVE ? String(womenServices) : t('site.comingSoon') },
];
const contactWhatsapp = `https://wa.me/${womenNotifyNumber}?text=${encodeURIComponent(t('contact.whatsappMessage', { shop: shop.name }))}`;
const notifyHref = `https://wa.me/${womenNotifyNumber}?text=${encodeURIComponent(t('who.womenNotifyMessage', { shop: shop.name }))}`;

// One nested frame for both cards: a hairline shell around the card, so each reads as a mounted print.
const shell = 'group block p-1.5 shadow-[inset_0_0_0_1px_var(--color-line)] transition duration-500 ease-out-soft hover:shadow-[inset_0_0_0_2px_var(--color-ink)]';
---

<BaseLayout
  title={t('home.title', { shop: shop.name })}
  description={t('home.description', { shop: shop.name })}
  tab="home"
>
  <JsonLd slot="head" data={website(Astro.site!)} />
  <main>
    {/* Hero: says what this is (a menu of looks and the services that go with them) and shows the menu itself. */}
    <section class="wrap pt-6 pb-2 md:pt-12 md:pb-4">
      <div class="grid gap-6 md:grid-cols-[1fr_26rem] md:items-center md:gap-14">
        <div>
          <p class="rise inline-flex items-center gap-2 rounded-full bg-paper-2 px-3 py-1.5 text-[0.625rem] font-semibold tracking-[0.2em] uppercase">
            <Icon name="sparkle" size={12} />
            {shop.name}
          </p>
          <h1 class="rise mt-3 text-[2.25rem] leading-[1.05] md:text-[3.5rem]" style="--rise-delay:80ms">{t('home.heading')}</h1>
          <p class="rise mt-3 max-w-md text-[0.9375rem] leading-relaxed text-muted" style="--rise-delay:160ms">{t('home.intro')}</p>
          <div class="rise mt-5 flex flex-wrap gap-3" style="--rise-delay:240ms">
            <Button href="#who" size="lg" arrow>{t('home.browseMenu')}</Button>
          </div>
        </div>
        <div class="rise bg-brand p-3 md:p-4" style="--rise-delay:200ms">
          <div class="bg-card p-5 shadow-[inset_0_0_0_1px_var(--color-line)] md:p-6">
            <div class="flex items-center justify-between">
              <span class="text-[1.5rem] leading-none font-bold tracking-[-0.02em]">looks<span class="text-brand">menu</span></span>
              <svg viewBox="0 0 100 100" class="size-8 rounded-[0.3rem] bg-brand" aria-hidden="true" set:html={menuMark()} />
            </div>
            {
              [
                { title: t('menu.looks'), rows: menuLooks },
                { title: t('menu.services'), rows: menuServices },
              ].map((group) => (
                <div class="mt-4 border-t border-line pt-3">
                  <p class="text-[0.625rem] font-semibold tracking-[0.2em] text-muted uppercase">{group.title}</p>
                  <ul class="mt-1">
                    {group.rows.map((row) => (
                      <li>
                        {row.href ? (
                          <a href={row.href} class="group flex min-h-11 items-baseline gap-2 py-2.5 text-[1rem] font-medium">
                            <span class="underline-offset-4 group-hover:underline">{row.label}</span>
                            <span class="mb-1 flex-1 border-b border-dotted border-ink/30" aria-hidden="true" />
                            <span class="text-[0.875rem] text-muted tabular-nums">{row.count}</span>
                          </a>
                        ) : (
                          <div class="flex min-h-11 items-baseline gap-2 py-2.5 text-[1rem] font-medium text-muted">
                            <span>{row.label}</span>
                            <span class="mb-1 flex-1 border-b border-dotted border-ink/20" aria-hidden="true" />
                            <span class="text-[0.75rem] font-semibold tracking-[0.08em] uppercase">{row.count}</span>
                          </div>
                        )}
                      </li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </div>
      </div>
    </section>

    {/* The choice, in full: a photo card for men and a colour card for women. */}
    <section id="who" class="wrap scroll-mt-20 py-8 md:py-14" aria-labelledby="who-title">
      <div data-reveal>
        <p class="inline-flex rounded-full bg-paper-2 px-3 py-1.5 text-[0.625rem] font-semibold tracking-[0.2em] uppercase">{t('who.label')}</p>
        <h2 id="who-title" class="mt-4 text-[2rem] leading-tight md:text-[2.75rem]">{t('who.title')}</h2>
        <p class="mt-2 max-w-md text-[0.9375rem] text-muted">{t('who.text')}</p>
      </div>
      <div class="mt-8 grid gap-4 md:mt-12 md:grid-cols-2 md:gap-6">
        <a href={l('/men')} class={shell} data-reveal style="--reveal-delay:80ms">
          <span class="relative block aspect-[4/3] overflow-hidden">
            <ItemPhoto
              item={{ id: 'L41', name: 'Skater Mullet', mainPhoto: 'front' }}
              decorative
              class="absolute inset-0 size-full object-[center_28%] transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]"
            />
          </span>
          <span class="flex items-center justify-between gap-4 p-4 md:p-5">
            <span>
              <span class="block text-[1.625rem] leading-tight font-semibold">{t('who.men')}</span>
              <span class="mt-1 block text-[0.875rem] leading-snug text-muted">{t('who.menText')}</span>
              <span class="mt-3 inline-flex rounded-full bg-paper-2 px-3 py-1 text-[0.6875rem] font-semibold tracking-[0.1em] uppercase">{t('men.styleCount', { count: String(styleCount) })}</span>
            </span>
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ink text-white transition duration-500 ease-out-soft group-hover:translate-x-1">
              <Icon name="arrowRight" size={20} strokeWidth={1.5} />
            </span>
          </span>
        </a>
        {WOMEN_LIVE ? (
        <a href={l('/women')} class={shell} data-reveal style="--reveal-delay:160ms">
          <span class="relative block aspect-[4/3] overflow-hidden">
            <ItemPhoto
              item={{ id: 'W05', name: 'Blow Dry & Styling', mainPhoto: 'front' }}
              decorative
              block="bg-block-blush"
              class="absolute inset-0 size-full object-[center_20%] transition-transform duration-700 ease-out-soft group-hover:scale-[1.04]"
            />
          </span>
          <span class="flex items-center justify-between gap-4 p-4 md:p-5">
            <span>
              <span class="block text-[1.625rem] leading-tight font-semibold">{t('who.women')}</span>
              <span class="mt-1 block text-[0.875rem] leading-snug text-muted">{t('who.womenText')}</span>
              <span class="mt-3 inline-flex rounded-full bg-paper-2 px-3 py-1 text-[0.6875rem] font-semibold tracking-[0.1em] uppercase">{t('women.tileCount', { count: String(womenServices) })}</span>
            </span>
            <span class="grid size-12 shrink-0 place-items-center rounded-full bg-ink text-white transition duration-500 ease-out-soft group-hover:translate-x-1">
              <Icon name="arrowRight" size={20} strokeWidth={1.5} />
            </span>
          </span>
        </a>
        ) : (
        <div class={shell.replace('group ', '').replace(/hover:\S+/, '')} data-reveal style="--reveal-delay:160ms">
          <span class="relative block aspect-[4/3] overflow-hidden">
            <ItemPhoto
              item={{ id: 'W05', name: 'Blow Dry & Styling', mainPhoto: 'front' }}
              decorative
              block="bg-block-blush"
              class="absolute inset-0 size-full object-[center_20%] opacity-60 saturate-50"
            />
            <span class="absolute top-3 left-3 rounded-full bg-ink px-3 py-1.5 text-[0.6875rem] font-semibold tracking-[0.14em] text-white uppercase">{t('who.womenSoon')}</span>
          </span>
          <span class="block p-4 md:p-5">
            <span class="block text-[1.625rem] leading-tight font-semibold">{t('who.women')}</span>
            <span class="mt-1 block text-[0.875rem] leading-snug text-muted">{t('who.womenSoonText')}</span>
            <span class="mt-4 block">
              <Button href={notifyHref} variant="dark" size="lg" arrow target="_blank" rel="noopener">{t('who.womenNotify')}</Button>
            </span>
          </span>
        </div>
        )}
      </div>
    </section>

    {/* Visit: address, hours and the two actions people want. */}
    <section class="wrap pb-16 md:pb-24" data-reveal>
      <div class="bg-ink p-1.5">
        <div class="grid gap-8 bg-ink p-6 text-white shadow-[inset_0_0_0_1px_rgb(255_255_255/0.14)] md:grid-cols-2 md:items-center md:p-10">
          <div>
            <p class="inline-flex rounded-full bg-white/10 px-3 py-1.5 text-[0.625rem] font-semibold tracking-[0.2em] uppercase">{t('footer.visit')}</p>
            <h2 class="mt-4 text-[1.75rem] leading-tight md:text-[2.25rem]">{shop.name}</h2>
            <p class="mt-4 max-w-sm text-[0.9375rem] text-muted-dark">{t('contact.tagline')}</p>
          </div>
          <div class="flex flex-wrap gap-3 md:justify-end">
            <Button href={`tel:${shop.phone}`} icon="phone" variant="outline-dark" size="lg">{shop.phoneDisplay}</Button>
            <Button href={contactWhatsapp} variant="outline-dark" size="lg" arrow target="_blank" rel="noopener">{t('contact.whatsapp')}</Button>
          </div>
        </div>
      </div>
    </section>

    {/* An open door for customers: what they expected, and what would make the app better. */}
    <section class="wrap pb-16 md:pb-24" data-reveal>
      <a href={l('/feedback')} class="group flex items-center gap-4 bg-paper-2 p-5 transition duration-500 ease-out-soft hover:bg-line md:p-7">
        <span class="grid size-12 shrink-0 place-items-center rounded-full bg-brand text-white">
          <Icon name="message" size={22} />
        </span>
        <span class="min-w-0 flex-1">
          <span class="block text-[1.125rem] leading-snug font-semibold">{t('feedback.ctaTitle')}</span>
          <span class="block text-sm text-muted">{t('feedback.ctaText')}</span>
        </span>
        <Icon name="arrowRight" size={20} strokeWidth={1.25} class="shrink-0 transition-transform duration-500 ease-out-soft group-hover:translate-x-1" />
      </a>
    </section>
  </main>
</BaseLayout>
